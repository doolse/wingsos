TOP = . ;

SubDir TOP ;

rule Makeimg
{
	Clean clean : $(<) ;
}

actions Makeimg 
{
	rm -f $(<)
	$(MKIM) -tc128 -o $(<) -s -v $(BINS)booter
	$(MKIM) -tc128 -o $(<) -i $(<) -v -d media -r $(EXTRAS)testfiles/ $(EXTRAS)testfiles/*
	$(MKIM) -tc128 -o $(<) -i $(<) -v -d wings -r $(BINS) $(BINS)*
}

# Flat 1581 image for emulators without a CMD HD (e.g. VICE xscpu64).
# 1581 DOS has no subdirectories, so .app bundles are left out.
# extras/vice/init replaces the normal init (userport DAC digi driver).
rule MakeD81
{
	Clean clean : $(<) ;
}

actions MakeD81
{
	rm -f $(<)
	$(MKIM) -t8 -o $(<) -s $(BINS)booter `find $(BINS)system $(BINS)libs $(BINS)drivers $(BINS)gui $(BINS)programs -type f -not -path "*.app/*" -not -name mitchdane.zip -not -path $(BINS)system/init` $(EXTRAS)vice/init $(EXTRAS)vice/netup $(EXTRAS)vice/ideup $(EXTRAS)testfiles/DASMODEL.MOD
}

# CMD native image with bins/ at its root, served over PPP by
# btools/netdrive and mounted as /wings/ by extras/vice/netup.
rule MakeNetImg
{
	Clean clean : $(<) ;
}

actions MakeNetImg
{
	rm -f $(<)
	$(MKIM) -tc128 -o $(<) -r $(BINS) $(BINS)*
}

# IDE64 image (pre-CFS IDEDOS CHS filesystem, read by idefsys.drv) with
# bins/ at its root. 64 cylinders x 16 heads x 63 sectors x 512 = 33MB.
# run-vice.sh --ide attaches it; extras/vice/ideup mounts it as /wings/.
rule MakeIdeImg
{
	Clean clean : $(<) ;
}

actions MakeIdeImg
{
	rm -f $(<)
	$(MKIM) -ti64 -o $(<) -r $(BINS) $(BINS)*
}

actions Zip
{
	cd $(BINS) 
	zip -r ../$(<) * -x $(>)
}

rule SendBoot
{
    Depends $(<) : $(>) ;
}

actions SendBoot
{
    cbmlink -c pc64 /dev/parport0 -l $(BINS)booter -r
    sleep 10
    cbmlink -c pc64 /dev/parport0 -i wings.img
}

actions SendNet
{
    cbmlink -c pc64 /dev/parport0 -l $(BINS)booter -r
}

actions RunJam
{
	cbmlink -c pc64 /dev/parport0 -l  $(EXTRAS)debug/JAM
	cbmlink -c pc64 /dev/parport0 -l  $(EXTRAS)debug/doJAM -j,0x0801
}

actions DumpCrash
{
	cbmlink -c pc64 /dev/parport0 -s,0x4000,@0x4000 $(>)
	$(DEBCRASH) $(>)
}


Depends image : all wings.img ;
Depends wings.img : all ;
Depends wings.d81 : all ;
Depends run : image sendboot ;
Depends run2 : image sendnet ;
Depends wings.zip : all ;

ALWAYS jam ;
NOTFILE jam ;
RunJam jam ;

ALWAYS dump ;
NOTFILE dump ;
DumpCrash dump : crashdump.prg ;

Makeimg wings.img ;
MakeD81 wings.d81 ;
ALWAYS wings.d81 ;
Depends wingsnet.img : all ;
MakeNetImg wingsnet.img ;
Depends wingside.hdd : all ;
MakeIdeImg wingside.hdd ;
NOTFILE sendboot ;
ALWAYS sendboot ;
SendBoot sendboot : $(EXTRAS)testfiles/coconut.mod ;
SendNet sendnet ;

HAVE_BTOOLS = 1 ;
HAVE_CRT = 1 ;
HAVE_LIBS = 1 ;

SubInclude TOP btools ;
SubInclude TOP lib src ;
SubInclude TOP programs ;
SubInclude TOP drivers ;
SubInclude TOP kernel ;

SubDir TOP ;

Zip wings.zip : $(INITRD_BINS) ;
